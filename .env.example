# Endereço que o frontend usa para consumir a API. Vazio mantém o modo local.
VITE_API_BASE_URL=http://localhost:8080

# Identificador livre para ambiente ou hospedagem.
VITE_DEPLOYMENT_TARGET=browser

# Troque para o provedor adotado pela sua organização.
VITE_STORAGE_PROVIDER=browser

# Configure no ambiente da API/Docker, não exponha no frontend.
API_ALLOWED_ORIGIN=http://localhost:5173
API_ACCESS_TOKEN=
DATA_DIRECTORY=./data
